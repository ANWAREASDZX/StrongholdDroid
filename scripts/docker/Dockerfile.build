# StrongholdDroid Build Environment
#
# Reproducible build container for Wine + Box64 + DXVK + gl4es.
# CI uses this image so local and cloud builds produce bit-identical
# artifacts.
#
# Image base: Ubuntu 22.04 LTS x86_64 (matches Wine's CI matrix).
#
# To build locally:
#   docker build -t strongholddroid-builder scripts/docker/
#
# To run a build inside the container:
#   docker run --rm -v $(pwd):/work strongholddroid-builder \
#       /work/scripts/build_all.sh
#
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    ANDROID_HOME=/opt/android-sdk \
    NDK_VERSION=26.1.10909125

# ---- 1. Apt dependencies for the host-side toolchain -----------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        bison flex \
        git wget curl unzip xz-utils zip \
        python3 python3-pip python3-venv \
        mingw-w64 mingw-w64-tools \
        cmake ninja-build pkg-config patchelf \
        ccache \
        glslang-tools \
        libfreetype6-dev libfreetype-dev \
        libx11-dev libxext-dev libxcomposite-dev libxrandr-dev \
        libxrender-dev libxcursor-dev libxinerama-dev libxi-dev \
        libxfixes-dev libxxf86vm-dev libxv-dev \
        libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
        libpulse-dev libasound2-dev \
        openjdk-17-jdk-headless \
        llvm \
        locales \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ---- 1b. llvm-mingw (PE cross-compilers) -----------------------------------
# Wine's PE builtin DLLs (aarch64 + i386 WoW64) and box64's wow64 cpu dll
# are compiled with aarch64-w64-mingw32-clang / i686-w64-mingw32-clang.
# Ubuntu 22.04's mingw-w64 only ships x86_64/i686 GCC (no aarch64), so we
# install llvm-mingw at /opt/llvm-mingw.  scripts/lib/common.sh adds its
# bin/ dir to PATH (LLVM_MINGW_BIN / /opt/llvm-mingw/bin detection).
ENV LLVM_MINGW_VERSION=20240619
RUN wget -q "https://github.com/mstorsjo/llvm-mingw/releases/download/${LLVM_MINGW_VERSION}/llvm-mingw-${LLVM_MINGW_VERSION}-ucrt-ubuntu-20.04-x86_64.tar.xz" -O /tmp/llvm-mingw.tar.xz \
    && tar -xJf /tmp/llvm-mingw.tar.xz -C /opt \
    && mv "/opt/llvm-mingw-${LLVM_MINGW_VERSION}-ucrt-ubuntu-20.04-x86_64" /opt/llvm-mingw \
    && rm /tmp/llvm-mingw.tar.xz \
    && /opt/llvm-mingw/bin/aarch64-w64-mingw32-clang --version | head -1

# Pre-configure ccache defaults (used when CircleCI passes CCACHE_DIR via -e).
# max_size = 2 GiB keeps the ccache well under CircleCI's 14 GiB cache limit
# even with both arm64 + x86_64 object files cached.  Compression is on by
# default in ccache 4.x — no need to set CCACHE_COMPRESS here.
RUN ccache --set-config=max_size=2G \
 && ccache --set-config=compiler_check=content \
 && ccache --set-config=hash_dir=false

ENV PATH="${PATH}:/usr/lib/jvm/java-17-openjdk-amd64/bin:/root/.local/bin:/opt/android-sdk/cmdline-tools/latest/bin"

# ---- 2. Android SDK + NDK -------------------------------------------------
RUN mkdir -p /opt/android-sdk && cd /opt/android-sdk \
    && wget -q "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip" -O /tmp/cmdtools.zip \
    && unzip -q /tmp/cmdtools.zip -d /opt/android-sdk/ \
    && mv /opt/android-sdk/cmdline-tools /opt/android-sdk/cmdline-tools-tmp \
    && mkdir -p /opt/android-sdk/cmdline-tools/latest \
    && mv /opt/android-sdk/cmdline-tools-tmp/* /opt/android-sdk/cmdline-tools/latest/ \
    && rmdir /opt/android-sdk/cmdline-tools-tmp \
    && rm /tmp/cmdtools.zip \
    && yes | sdkmanager --licenses > /dev/null \
    && yes | sdkmanager "platform-tools" "platforms;android-34" \
                       "ndk;${NDK_VERSION}" "cmake;3.22.1"

ENV ANDROID_NDK_HOME="/opt/android-sdk/ndk/${NDK_VERSION}"

# ---- 3. Python build tools (meson, ninja via pip — newer than apt) -------
# NOTE 1: Ubuntu 22.04 ships pip 22.0.2 which pre-dates PEP 668 — the
# `--break-system-packages` flag (pip 23.0+) is unrecognised and causes
# `no such option` error. Upgrade pip first, then install without the flag.
# NOTE 2: `ninja==1.12.1` does NOT exist on PyPI (PyPI versions jump from
# 1.11.1.4 → 1.13.0). We rely on `ninja-build` apt package (installed
# above) which provides the `ninja` binary — newer Ninja versions don't
# change the file format so 1.10.2 from apt is fully compatible with
# modern CMake + Meson.
RUN python3 -m pip install --upgrade pip==24.3.1 \
    && pip3 install \
        meson==1.4.0 \
        cmake==3.30.3

# ---- 3b. Gradle 8.7 (system-wide) -----------------------------------------
# The repo's gradlew stub falls back to `gradle` on PATH when the
# gradle-wrapper.jar is missing (which it is in this repo — only the
# .properties file is committed). Installing Gradle in the image means
# `./gradlew :app:assembleDebug` works without any manual bootstrap.
# Matches the version pinned in gradle/wrapper/gradle-wrapper.properties.
ENV GRADLE_VERSION=8.7
RUN wget -q "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -O /tmp/gradle.zip \
 && unzip -q /tmp/gradle.zip -d /opt \
 && ln -sf "/opt/gradle-${GRADLE_VERSION}/bin/gradle" /usr/local/bin/gradle \
 && rm /tmp/gradle.zip \
 && gradle --version | head -3

# ---- 4. Project working dir -----------------------------------------------
WORKDIR /work

# Default entrypoint: drop into a shell for interactive debugging
CMD ["/bin/bash"]
