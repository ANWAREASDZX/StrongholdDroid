<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="control_profiles/"/>
        <include domain="file" path="game_profiles/"/>
        <include domain="file" path="saves/"/>
        <exclude domain="file" path="prefixes/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="control_profiles/"/>
        <include domain="file" path="saves/"/>
        <exclude domain="file" path="prefixes/"/>
        <exclude domain="file" path="usr/"/>
        <exclude domain="file" path="dxvk/"/>
    </device-transfer>
</data-extraction-rules>
