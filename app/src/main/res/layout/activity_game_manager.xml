<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Future home for an embedded X server surface. -->
    <SurfaceView
        android:id="@+id/wineSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- RTS overlay floats on top and forwards input to Wine via InputBridge. -->
    <com.strongholddroid.emulator.controls.RtsControlOverlay
        android:id="@+id/rtsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Launch status panel: live phase, progress, error surfaces.
         Semi-transparent so it reads over the black surface. -->
    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:padding="16dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/launchProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            app:indicatorColor="#FFFFFF"/>

        <TextView
            android:id="@+id/runningHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B0FFFFFF"
            android:textSize="13sp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/stop_game"
                android:visibility="gone"
                app:strokeColor="#FFFFFF"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logBtn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_wine_log"
                android:textColor="#B0FFFFFF"/>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
